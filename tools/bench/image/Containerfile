# bench image of the darktable project (manifest: ../bench.toml): what a job
# needs, with no network at run time. The box rebuilds it when this
# directory changes. labwc runs headless with the pixman renderer: there is
# no GPU in the container.
FROM registry.fedoraproject.org/fedora:44

RUN dnf -y install dnf-plugins-core \
 && dnf -y builddep darktable \
 && dnf -y install git cmake ninja-build gcc-c++ ccache gdb sqlite libcmocka-devel \
      ImageMagick dbus-daemon labwc grim wtype wlrctl wl-clipboard \
      xdotool xprop setxkbmap wlr-randr xorg-x11-server-Xwayland procps-ng \
      python3 python3-pip python3-pyyaml \
 && dnf clean all

# the pixel runner's Python dependencies (src/tests/integration/requirements.txt)
RUN python3 -m venv /opt/dt-tests-venv \
 && /opt/dt-tests-venv/bin/pip install --quiet --upgrade pip \
 && /opt/dt-tests-venv/bin/pip install --quiet "colour-science>=0.4.4" "numpy>=1.24" \
      "scipy>=1.10" "imageio>=2.9" "pillow>=9.0" "packaging>=20.0" "matplotlib>=3.7"

# wbox drives darktable in a headless labwc for the benches
RUN python3 -m venv /opt/wbox \
 && /opt/wbox/bin/pip install --quiet "git+https://github.com/quazardous/wbox-mcp.git"

ENV CCACHE_DIR=/ccache \
    WBOX_PYTHON=/opt/wbox/bin/python3 \
    DARKTABLE_TESTS_VENV=/opt/dt-tests-venv \
    HOME=/tmp/home \
    XDG_RUNTIME_DIR=/tmp/xdg \
    WLR_RENDERER=pixman

