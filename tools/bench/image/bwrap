#!/usr/bin/env python3
# stand-in for bubblewrap inside the bench container. GTK loads icons through
# glycin, which runs each image decoder under bwrap; bwrap cannot create its
# namespaces inside a rootless container, glycin does not fall back, and
# darktable aborts on its first SVG icon. The container is already the
# sandbox, so this runs the decoder directly: it applies the --setenv and
# --chdir options and ignores the rest (binds, tmpfs, seccomp).
import os
import sys

# bwrap options and how many arguments each takes
ARGS = {
    "--unshare-all": 0, "--share-net": 0, "--die-with-parent": 0, "--clearenv": 0,
    "--new-session": 0, "--as-pid-1": 0, "--unshare-user": 0, "--unshare-ipc": 0,
    "--unshare-pid": 0, "--unshare-net": 0, "--unshare-uts": 0, "--unshare-cgroup": 0,
    "--chdir": 1, "--dev": 1, "--proc": 1, "--tmpfs": 1, "--seccomp": 1, "--unsetenv": 1,
    "--remount-ro": 1, "--dir": 1, "--uid": 1, "--gid": 1, "--hostname": 1, "--cap-add": 1,
    "--cap-drop": 1, "--size": 1, "--perms": 1, "--sync-fd": 1, "--block-fd": 1,
    "--info-fd": 1, "--json-status-fd": 1, "--userns": 1, "--userns2": 1, "--pidns": 1,
    "--ro-bind": 2, "--ro-bind-try": 2, "--bind": 2, "--bind-try": 2, "--dev-bind": 2,
    "--dev-bind-try": 2, "--symlink": 2, "--setenv": 2, "--file": 2, "--bind-data": 2,
    "--ro-bind-data": 2,
}

argv = sys.argv[1:]
env = dict(os.environ)
cwd = None
i = 0
while i < len(argv) and argv[i].startswith("--"):
    opt = argv[i]
    if opt not in ARGS:
        sys.exit(f"bwrap stand-in: unknown option {opt}")
    params = argv[i + 1:i + 1 + ARGS[opt]]
    if opt == "--setenv":
        env[params[0]] = params[1]
    elif opt == "--unsetenv":
        env.pop(params[0], None)
    elif opt == "--chdir":
        cwd = params[0]
    i += 1 + ARGS[opt]

if i >= len(argv):
    sys.exit("bwrap stand-in: no command")
if cwd:
    os.chdir(cwd)
os.execvpe(argv[i], argv[i:], env)
