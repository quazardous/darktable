#!/usr/bin/env python3
# A drop-in for src/tests/integration/deltae, for the fork's measurement
# workflow (darktable #3958): same arguments, report and exit codes
# (0 same, 1 small difference, 2 failure), with two changes.
#
#  - Decoded pixels are compared first: equal arrays exit 0 without the
#    dE 2000 computation, the slowest part of the suite (~1-4 s per test).
#    Comparing the files is not enough: no PNG is byte-identical to its
#    reference even when its pixels are.
#  - DT_TESTS_TOLERANT=1 judges by the 99.99th percentile of dE instead of
#    its max, so a few isolated pixels that differ between machines (grain,
#    LUT interpolation, lens correction edges) pass, while the max stays
#    capped so that isolated pixels which are really wrong still fail:
#      p99.99 <= 2.3 and avg <= 2.3 / 3 and max <= 10
#    Without it, the verdict is the suite's: max <= 2.3 and avg <= 2.3 / 3.

import os
import sys

import colour
import numpy

MAX_DELTA_E = 2.3
MAX_AVG_DELTA_E = MAX_DELTA_E / 3.
TOLERANT_PERCENTILE = 99.99
TOLERANT_MAX = 10.

expected_rgb = colour.read_image(sys.argv[1], method="Imageio")
output_rgb = colour.read_image(sys.argv[2], method="Imageio")

if expected_rgb.shape == output_rgb.shape and numpy.array_equal(expected_rgb, output_rgb):
    print("      ----------------------------------")
    print("      Identical pixels")
    print("      ----------------------------------")
    exit(0)

expected_lab = colour.XYZ_to_Lab(colour.sRGB_to_XYZ(expected_rgb, chromatic_adaptation_transform="Bradford"))
output_lab = colour.XYZ_to_Lab(colour.sRGB_to_XYZ(output_rgb, chromatic_adaptation_transform="Bradford"))
delta_E = colour.delta_E(expected_lab, output_lab, method="CIE 2000")

max_dE = numpy.amax(delta_E)
mean_dE = numpy.mean(delta_E)
p_dE = numpy.percentile(delta_E, TOLERANT_PERCENTILE)
count_above = numpy.sum(delta_E >= MAX_DELTA_E)

print("      ----------------------------------")
print("      Max dE                   : %.5f" % max_dE)
print("      Avg dE                   : %.5f" % mean_dE)
print("      Std dE                   : %.5f" % numpy.std(delta_E))
print("      p%.2f dE                 : %.5f" % (TOLERANT_PERCENTILE, p_dE))
print("      ----------------------------------")
print("      Pixels above tolerance   : %.4f %%" % (count_above / delta_E.size * 100.))

if os.environ.get("DT_TESTS_TOLERANT"):
    failed = p_dE > MAX_DELTA_E or mean_dE > MAX_AVG_DELTA_E or max_dE > TOLERANT_MAX
else:
    failed = max_dE > MAX_DELTA_E or mean_dE > MAX_AVG_DELTA_E

if failed:
    exit(2)
elif max_dE < 0.01:
    exit(0)
else:
    exit(1)
